[Unit]
Description=account approval worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Environment=ACCOUNT_PLATFORM_RUNTIME_REVIEWED=0
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/local/sbin/covin-account-worker
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
